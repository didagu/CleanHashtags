{
  "name": "@cleanhashtags/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist', { recursive: true })\" && wrangler dev",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply cleanhashtags --local",
    "db:seed": "pnpm db:migrate:local && node scripts/seed.ts",
    "db:migrate:remote": "wrangler d1 migrations apply cleanhashtags --remote",
    "db:seed:remote": "pnpm db:migrate:remote && node scripts/seed.ts --remote",
    "deploy": "pnpm --filter @cleanhashtags/web build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cleanhashtags/shared": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  }
}
