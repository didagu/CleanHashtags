{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hashdetector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hashdetector",
      "migrations_dir": "migrations",
    },
  ],
}
